{
  "name": "crm-ideali",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3100",
    "build": "node scripts/construir.mjs",
    "start": "node scripts/servir.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test:unidade": "node scripts/testar.mjs testes/unidade",
    "test:integracao": "node scripts/testar.mjs testes/integracao",
    "test:telas": "node --conditions=react-server node_modules/@playwright/test/cli.js test",
    "test": "node scripts/testar.mjs",
    "db:migrate": "node --conditions=react-server --import tsx scripts/migrar.ts",
    "backup": "node --conditions=react-server --import tsx scripts/backup.ts",
    "restaurar": "node --conditions=react-server --import tsx scripts/restaurar.ts",
    "arquivos:limpar": "node --conditions=react-server --import tsx scripts/limpar-arquivos.ts",
    "acesso:gestor": "node --conditions=react-server --import tsx scripts/criar-primeiro-gestor.ts",
    "demonstracao": "node --conditions=react-server --import tsx scripts/preparar-demonstracao.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1138.0",
    "better-auth": "1.7.5",
    "next": "16.3.6",
    "nodemailer": "10.0.10",
    "pdf-lib": "1.17.1",
    "pg": "8.23.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "sharp": "0.35.4",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "24.13.6",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "embedded-postgres": "17.10.0-beta.17",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.6",
    "prettier": "3.9.9",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.1"
  }
}
