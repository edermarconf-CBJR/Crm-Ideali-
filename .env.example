APP_ORIGIN=http://127.0.0.1:3100
BETTER_AUTH_SECRET=GERAR_SEGREDO_ALEATORIO_COM_PELO_MENOS_32_CARACTERES
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_FROM=Ideali <acesso@example.test>
S3_ENDPOINT=http://127.0.0.1:8333
S3_REGION=us-east-1
