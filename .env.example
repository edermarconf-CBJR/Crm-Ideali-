# Ferramentas pg_dump/pg_restore 17.x; caminho da pasta bin.
PG_TOOLS_DIR=
# Restauração: configure SOMENTE para ensaio em base e bucket separados.
# RESTORE_MODE=isolado
# RESTORE_DATABASE_URL=postgresql://usuario:SENHA@127.0.0.1:55432/ideali_restauracao_teste
